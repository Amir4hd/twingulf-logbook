rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // The admin list is managed only in the Firebase console.
    match /admins/{id} { allow read: if signedIn(); allow write: if false; }

    // Setup: everyone signed in can read, only admins can change.
    match /config/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // The shift leader tablet account may change the operators list (operators, passwords, active). Only the admin console assigns leaders in practice.
    function isLeaderAcct() { return signedIn() && request.auth.token.email != null && request.auth.token.email.lower().matches('(shiftleader|leader|shift)@.*'); }
    match /config/operators { allow write: if isLeaderAcct(); }

    // Maintenance tasks and history: any signed-in account can add and update; the admin and the maintenance account can delete.
    function isMaintAcct() { return signedIn() && request.auth.token.email != null && request.auth.token.email.lower().matches('(maint|maintenance)@.*'); }
    match /maint_tasks/{id}   { allow read, create, update: if signedIn(); allow delete: if isAdmin() || isMaintAcct(); }
    match /maint_history/{id} { allow read, create, update: if signedIn(); allow delete: if isAdmin() || isMaintAcct(); }

    // Readings, regrinding, problem reports, press-to-packaging messages and tablet heartbeats: tablet accounts can read and write.
    match /logs/{id}     { allow read, write: if signedIn(); allow delete: if isAdmin(); }
    match /issues/{id}   { allow read, write: if signedIn(); allow delete: if isAdmin(); }
    match /notices/{id}  { allow read, write: if signedIn(); allow delete: if isAdmin(); }
    match /presence/{id} { allow read, write: if signedIn(); }
    // One open tablet per account: each account's session record.
    match /sessions/{id} { allow read, write: if signedIn(); }
  }
}
