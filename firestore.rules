rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // The admin list is managed only in the Firebase console.
    match /admins/{id} { allow read: if signedIn(); allow write: if false; }

    // Setup: everyone signed in can read, only admins can change.
    match /config/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Maintenance tasks and history: the maintenance tablet (any signed-in account) can add and update; only admins can delete.
    match /maint_tasks/{id}   { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /maint_history/{id} { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }

    // Readings, regrinding, problem reports, press-to-packaging messages and tablet heartbeats: tablet accounts can read and write.
    match /logs/{id}     { allow read, write: if signedIn(); allow delete: if isAdmin(); }
    match /issues/{id}   { allow read, write: if signedIn(); allow delete: if isAdmin(); }
    match /notices/{id}  { allow read, write: if signedIn(); allow delete: if isAdmin(); }
    match /presence/{id} { allow read, write: if signedIn(); }
  }
}
